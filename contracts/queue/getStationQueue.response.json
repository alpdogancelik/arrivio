{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/queue/getStationQueue.response.json",
  "title": "getStationQueue response",
  "type": "object",
  "additionalProperties": true,
  "required": ["stationId", "queue"],
  "properties": {
    "stationId": { "type": "string", "minLength": 1 },
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "queueStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "carrierId": { "type": "string" },
          "stationId": { "type": "string" },
          "slotKey": { "type": "string" },
          "queueStatus": {
            "type": "string",
            "enum": ["Queued", "InProgress", "Completed", "Cancelled"]
          }
        }
      }
    }
  }
}
